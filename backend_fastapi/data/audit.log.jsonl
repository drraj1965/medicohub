{"id": "evt_7d46b06cff31", "entity_type": "question", "entity_id": "qst_49961d378034", "action": "created", "actor_id": "YjAuMPiqUBfy0oJiVNfK445JdhN2", "payload": {"id": "qst_49961d378034", "author_id": "YjAuMPiqUBfy0oJiVNfK445JdhN2", "target_doctor_id": "TNqEfA0eOGOLB2Peufu8yA1ZFhB3", "type": "forum", "heading_group": "Related to my medications", "title": "My stroke medications", "body": "Doctor, I had stroke in 2025. I was treated by you at Aster Hospital. I was admitted for 3 days. After that I have been taking medicines, such as aspirin, bp medicines, cholesterol medicines. I wanted to know how long to continue these medications? I have been told that once you start BP medicines, you have to continue it lifelong, but now my BP is normal; should I continue the bp medicine?", "tags": ["Neurology", "English", "Related to my medications", "Forum"], "language": "English", "symptoms_summary": "", "current_diagnosis_text": null, "premium": false, "is_public": false, "payment_status": "not_required", "status": "open", "bookmark_count": 0, "upvote_count": 0, "attachment_ids": ["att_1c36ff7417f4"], "responses": [], "created_at": "2026-05-01T06:15:41.222218Z", "updated_at": "2026-05-01T06:15:41.222218Z", "ai_summary": "Open forum request tagged Neurology, English, Related to my medications."}, "created_at": "2026-05-01T06:15:42.311574Z"}
